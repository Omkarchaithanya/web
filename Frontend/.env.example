# Frontend runtime / build configuration (Vite)
# Copy to .env and adjust per environment. Never commit secrets.

# Public API base path used by the browser (proxied in local dev)
VITE_API_BASE_URL=/api/v1

# Backend origin for Vite dev-server proxy only
VITE_API_PROXY_TARGET=http://localhost:4000

# WebSocket endpoint for live telemetry
VITE_WS_URL=ws://localhost:4000/ws

# Canonical site URL (SEO / OG)
VITE_SITE_URL=https://www.urbantree-sunex.com

# Company contacts
VITE_CONTACT_EMAIL=contact@sunex-technologies.com
VITE_PRIVACY_EMAIL=privacy@urbantree.com

# Social profiles (leave empty to hide the icon)
VITE_SOCIAL_TWITTER=https://twitter.com/SunExTech
VITE_SOCIAL_GITHUB=https://github.com/SunEx-Technologies/urbantree
VITE_SOCIAL_LINKEDIN=
VITE_SOCIAL_INSTAGRAM=
VITE_SOCIAL_YOUTUBE=

# Optional login role autofill (dev only). Leave empty in production.
VITE_DEMO_SUPER_EMAIL=
VITE_DEMO_SUPER_PASSWORD=
VITE_DEMO_GOVT_EMAIL=
VITE_DEMO_GOVT_PASSWORD=
VITE_DEMO_TECH_EMAIL=
VITE_DEMO_TECH_PASSWORD=
