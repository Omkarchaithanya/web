# ── Application ──────────────────────────────────────────────
NODE_ENV=development
PORT=4000
API_VERSION=v1
API_PREFIX=/api/v1
TRUST_PROXY=false

# ── Database (PostgreSQL) ────────────────────────────────────
DATABASE_URL=postgresql://urbantree:CHANGE_ME_db_password@localhost:5432/urbantree?schema=public
POSTGRES_USER=urbantree
POSTGRES_PASSWORD=CHANGE_ME_db_password
POSTGRES_DB=urbantree

# ── Redis (sessions, rate limiting, cache) ───────────────────
REDIS_URL=redis://localhost:6379

# ── JWT Authentication ───────────────────────────────────────
JWT_ACCESS_SECRET=CHANGE_ME_access_secret_min_32_chars_long_random_string
JWT_REFRESH_SECRET=CHANGE_ME_refresh_secret_min_32_chars_long_random_string
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
JWT_ISSUER=urbantree-api
JWT_AUDIENCE=urbantree-client

# ── IoT Device Ingestion ─────────────────────────────────────
IOT_API_KEY=CHANGE_ME_iot_device_ingestion_key_min_32_chars

# ── CORS ─────────────────────────────────────────────────────
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# ── Rate Limiting ────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=10

# ── Email (optional — enquiry notifications) ─────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
ENQUIRY_NOTIFY_EMAIL=

# ── Observability ────────────────────────────────────────────
SENTRY_DSN=
LOG_LEVEL=info

# ── Seed (local only — required for prisma db seed) ──────────
SEED_DEFAULT_PASSWORD=CHANGE_ME_seed_password_min_8
SEED_SUPER_EMAIL=superadmin@urbantree.com
SEED_GOVT_EMAIL=govtadmin@urbantree.com
SEED_TECH_EMAIL=tech@urbantree.com

# ── AWS Region ───────────────────────────────────────────────
AWS_REGION=ap-south-1

# ── PLC / telemetry ──────────────────────────────────────────
PLC_MODE=simulated
PLC_COM_PORT=COM1
PLC_BAUD_RATE=9600
PLC_SLAVE_ID=1
PLC_POLL_INTERVAL_MS=5000
REGISTER_MAP_CONFIRMED=false
SENSOR_RETENTION_DAYS=30
