# ── Application ──────────────────────────────────────────────
NODE_ENV=development
PORT=4000
API_VERSION=v1
API_PREFIX=/api/v1

# ── Database (PostgreSQL) ────────────────────────────────────
DATABASE_URL=postgresql://urbantree:urbantree_secret@localhost:5432/urbantree?schema=public

# ── Redis (sessions, rate limiting, cache) ───────────────────
REDIS_URL=redis://localhost:6379

# ── JWT Authentication ───────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=CHANGE_ME_access_secret_min_32_chars_long_random_string
JWT_REFRESH_SECRET=CHANGE_ME_refresh_secret_min_32_chars_long_random_string
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ── IoT Device Ingestion ─────────────────────────────────────
IOT_API_KEY=CHANGE_ME_iot_device_ingestion_key_min_32_chars

# ── CORS ─────────────────────────────────────────────────────
CORS_ORIGIN=http://localhost:8000,http://127.0.0.1:8000

# ── Rate Limiting ────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=10

# ── Email (optional — enquiry notifications) ─────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
ENQUIRY_NOTIFY_EMAIL=sunex.technology4@gmail.com

# ── AWS Region (production deployment) ───────────────────────
AWS_REGION=ap-south-1

# ── Logging ──────────────────────────────────────────────────
LOG_LEVEL=info

# ── PLC Configurations ───────────────────────────────────────
PLC_MODE=simulated
PLC_COM_PORT=COM1
PLC_BAUD_RATE=9600
PLC_SLAVE_ID=1
PLC_POLL_INTERVAL_MS=5000
